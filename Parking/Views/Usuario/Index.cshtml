@using Parking.ViewModels.CuentaVM
@using System.Text.Json
@{
    ViewData["Title"] = "Usuarios";
}
@model IReadOnlyList<UsuarioViewModel>;
<div class="mt-4 text-center">
    <h1 class="display-5">@ViewData["Title"]</h1>
    <a class="btn btn-primary mt-4" asp-controller="Cuenta" asp-action="Registro">Crear Usuario</a>
</div>
<table class="table mt-4">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Usuario</th>
            <th>Rol</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.NombreCompleto</td>
                    <td>@usuario.UserName</td>
                    <td>@usuario.Rol</td>
                    <td>
                        <div class="botones-accion btn-group" role="group">
                            <a class="btn btn-warning" asp-controller="" asp-action="" asp-route-id="">Editar</a>
                            <a class="btn btn-danger btn-eliminar" asp-controller="" asp-action="" asp-route-id="">Eliminar</a>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4">No hay usuarios creados</td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function(){
        const swalText = @Html.Raw(JsonSerializer.Serialize(TempData["SwalText"]));
        const swalIcon = @Html.Raw(JsonSerializer.Serialize(TempData["SwalIcon"]));
        if(swalText && swalIcon){
            swal.fire({
                text: swalText,
                icon: swalIcon
            });
        }
        });
    </script>
}