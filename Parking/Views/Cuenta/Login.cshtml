@using Parking.ViewModels.CuentaVM
@using System.Text.Json
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LayoutCuenta.cshtml";
}
@model LoginViewModel;
<h1 class="display-5 mt-4 text-center">Parking</h1>
<form asp-action="Login" class="mt-4">
    <div class="form-floating">
        <input asp-for="Usuario" type="text" class="form-control" placeholder=" " />
        <label asp-for="Usuario"></label>
        <span asp-validation-for="Usuario" class="small text-danger"></span>
    </div>
    <div class="form-floating mt-4">
        <input asp-for="Contrasena" type="password" class="form-control" placeholder=" " name="Contrasena" id="Contrasena" autocomplete="current-password"/>
        <label asp-for="Contrasena"></label>
        <span asp-validation-for="Contrasena" class="small text-danger"></span>
    </div>
    <div class="mt-4 acciones-login">
        <div class="form-check">
            <input asp-for="RecordarContrasena" type="checkbox" class="form-check-input" />
            <label class="form-check-label">Mantener sesión iniciada</label>
        </div>
        <a asp-action="ValidarContrasena">¿Olvidó su contraseña?</a>
    </div>
    <div class="mt-4 text-center">
        <button class="btn btn-primary" type="submit">Login</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function(){
            const swalText = @Html.Raw(JsonSerializer.Serialize(TempData["SwalText"]));
            const swalIcon = @Html.Raw(JsonSerializer.Serialize(TempData["SwalIcon"]));
            if(swalText && swalIcon){
                swal.fire({
                    html: swalText,
                    icon: swalIcon
                });
            }
        });
    </script>
}