@using Parking.ViewModels.CuentaVM
@using System.Text.Json
@{
    ViewData["Title"] = "Validar Contraseña";
    Layout = "~/Views/Shared/_LayoutCuenta.cshtml";
}
@model ValidarContrasenaViewModel;
<div class="mt-4 display-5 text-center">@ViewData["Title"]</div>
<form asp-action="ValidarContrasena" class="mt-4">
    <div class="form-floating">
        <input asp-for="Usuario" type="text" class="form-control" placeholder=" " />
        <label asp-for="Usuario"></label>
        <span asp-validation-for="Usuario" class="small text-danger"></span>
    </div>
    <div class="mt-4 text-center">
        <button class="btn btn-primary" type="submit">Restaurar Contraseña</button>
        <a asp-action="Login" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function(){
            const swalText = @Html.Raw(JsonSerializer.Serialize(TempData["SwalText"]));
            const swalIcon = @Html.Raw(JsonSerializer.Serialize(TempData["SwalIcon"]));
            if(swalText && swalIcon){
                swal.fire({
                    text: swalText,
                    icon: swalIcon
                });
            }
        });
    </script>
}